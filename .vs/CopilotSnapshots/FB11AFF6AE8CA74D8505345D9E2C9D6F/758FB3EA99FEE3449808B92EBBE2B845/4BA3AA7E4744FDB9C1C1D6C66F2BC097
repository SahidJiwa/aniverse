  Widget _buildGenreGrid() {
    final genres = MockDataService.getGenres();
    // Harmonized to the AniVerse pink/purple/gold family (matches the
    // palette used across Home) instead of flat iOS system colors, which
    // clashed with the app's identity.
    const accents = [
      Color(0xFFFF4FA3), // Action — AniVerse pink
      Color(0xFF7C3AED), // Adventure — AniVerse purple
      Color(0xFFFFB443), // Comedy — warm amber
      Color(0xFFFF7A6B), // Drama — coral
      Color(0xFF06B6D4), // Sci-Fi — cyan
      Color(0xFFA855F7), // Fantasy — violet
      Color(0xFF6D28D9), // Horror — deep indigo
    ];
    const icons = [
      Icons.local_fire_department_rounded,
      Icons.explore_rounded,
      Icons.sentiment_very_satisfied_rounded,
      Icons.theater_comedy_rounded,
      Icons.rocket_launch_rounded,
      Icons.auto_fix_high_rounded,
      Icons.nightlight_round,
    ];

    // Count titles per genre from the loaded animes
    final Map<String, int> countsByGenre = {};
    for (final anime in _allAnimes) {
      for (final g in _genresOf(anime)) {
        countsByGenre[g] = (countsByGenre[g] ?? 0) + 1;
      }
    }

    final rows = <Widget>[];
    for (int i = 0; i < genres.length; i += 2) {
      final hasPair = i + 1 < genres.length;
      rows.add(
        Padding(
          padding: EdgeInsets.only(bottom: i + 2 < genres.length ? 10 : 0),
          child: Row(
            children: [
              Expanded(
                child: AspectRatio(
                  aspectRatio: hasPair ? 2.6 : 5.4,
                  child: _GenreGridCard(
                    label: genres[i],
                    accent: accents[i % accents.length],
                    icon: icons[i % icons.length],
                    count: countsByGenre[genres[i]] ?? 0,
                    onTap: () => _selectGenre(genres[i]),
                  ),
                ),
              ),
              if (hasPair) ...[
                const SizedBox(width: 10),
                Expanded(
                  child: AspectRatio(
                    aspectRatio: 2.6,
                    child: _GenreGridCard(
                      label: genres[i + 1],
                      accent: accents[(i + 1) % accents.length],
                      icon: icons[(i + 1) % icons.length],
                      count: countsByGenre[genres[i + 1]] ?? 0,
                      onTap: () => _selectGenre(genres[i + 1]),
                    ),
                  ),
                ),
              ],
            ],
          ),
        ),
      );
    }

    return RepaintBoundary(child: Column(children: rows));
  }

  Widget _buildAnimeGridInline(List<AnimeModel> animes) {
    // Responsive: 2 / 3 / 4 columns
    final width = MediaQuery.of(context).size.width;
    final cols = width < 480
        ? 2
        : width < 800
        ? 3
        : 4;
    return RepaintBoundary(
      child: GridView.builder(
        shrinkWrap: true,
        physics: const NeverScrollableScrollPhysics(),
      gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: cols,
        crossAxisSpacing: 12,
        mainAxisSpacing: 14,
        childAspectRatio: 0.60,
      ),
      itemCount: animes.length,
      itemBuilder: (context, i) =>
          _StaggeredAnimeCard(anime: animes[i], index: i),
    ),
  );
}

  // ── Results grid (SliverGrid) ──────────────────────────────────────────────

  Widget _buildResultsGrid() {
    final width = MediaQuery.of(context).size.width;
    final cols = width < 480
        ? 2
        : width < 800
        ? 3
        : 4;

    return SliverPadding(
      padding: const EdgeInsets.fromLTRB(16, 4, 16, 0),
      sliver: SliverGrid(
        gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
          crossAxisCount: cols,
          crossAxisSpacing: 12,
          mainAxisSpacing: 14,
          childAspectRatio: 0.60,
        ),
        delegate: SliverChildBuilderDelegate(
          (context, i) => SlideTransition(
            position: _resultsSlide,
            child: FadeTransition(
              opacity: _resultsFade,
              child: _StaggeredAnimeCard(anime: _filtered[i], index: i),
            ),
          ),
          childCount: _filtered.length,
        ),
      ),
    );
  }

  // ── Empty state ────────────────────────────────────────────────────────────

  Widget _buildEmptyState() {
    return _EmptyState(
      query: _query,
      genre: _selectedGenre,
      onClearSearch: _clearSearch,
      onClearGenre: () => _selectGenre(null),
    );
  }
}

