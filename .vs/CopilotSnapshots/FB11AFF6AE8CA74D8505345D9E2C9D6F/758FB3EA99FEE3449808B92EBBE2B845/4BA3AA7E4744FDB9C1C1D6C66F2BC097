  Widget _buildForYouRow() {
    // Curate: highest rated + genre affinity based on hub interactions
    final sorted = List<AnimeModel>.from(_allAnimes)
      ..sort((a, b) => b.rating.compareTo(a.rating));
    // Shuffle slightly for discovery feeling (but keep high-rated bias)
    final seed = DateTime.now().day; // stable within the day
    final rng = math.Random(seed);
    final picks = sorted.take(20).toList()..shuffle(rng);
    final forYou = picks.take(10).toList();

    return SizedBox(
      height: 225,
      child: ListView.builder(
        scrollDirection: Axis.horizontal,
        physics: const BouncingScrollPhysics(),
        clipBehavior: Clip.none,
        itemCount: forYou.length,
        itemBuilder: (context, i) {
          final anime = forYou[i];
          return Stack(
            clipBehavior: Clip.none,
            children: [
              AnimeCard(anime: anime, width: 130),
              Positioned(
                top: -4,
